# --- Required ---
# Random secret, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Public base URL of this gateway (must match the port the app derives).
BETTER_AUTH_URL=http://localhost:17600

# --- Optional ---
# Gateway listening port. The Flutter app derives this as its backend base.
PORT=17600
# SQLite database file (dev). Replace adapter with Postgres in production.
DB_PATH=./data/gateway.db
# Directory holding the skills/agents/mcp catalogs (see src/catalog/index.ts).
# Dev default points at the repo's server/config; production typically mounts
# a read-only catalog at /config and overrides this.
CONFIG_DIR=./config
# Dedicated SQLite file for the gateway task ledger (append-only + hash chain).
LEDGER_DB_PATH=./data/ledger.db
# Ledger heartbeat thresholds. Ordering is FIXED: stuck < lease. Final tuning
# is Phase 4 (M5); these are conservative dev defaults.
LEDGER_STUCK_TIMEOUT_MS=10000
LEDGER_LEASE_EXPIRY_MS=60000
# Encryption key for the notify store (ntfy topic + access token at rest).
# REQUIRED in production. Generate: openssl rand -hex 32
NOTIFY_STORE_KEY=
# Plugin store (Phase 1): JSON file persisting admin-installed tool-plugin
# manifests (builtins ship in the build and are never persisted).
PLUGINS_STORE_PATH=./data/plugins.json
# Comma-separated hostnames/IPs that bypass SSRF private-range rejection for
# plugin baseUrls (admin-trusted internal hosts, e.g. vikunja.local, *.local).
# Scheme enforcement (https in production) is NEVER bypassed.
PLUGINS_TRUSTED_HOSTS=
# Comma-separated admin-vouched MCP server hosts (in-cluster ClusterIPs). These
# bypass private-range rejection for MCP calls ONLY, and — unlike plugins — MAY
# use http: in production, because internal MCP SSE/streamable servers are plain
# http. Everything else (plugins, LLM endpoints) stays https-only; DNS-rebinding
# pinning and redirect refusal still apply to MCP.
# e.g. *.productivity.svc.cluster.local,ln.health.svc.cluster.local
MCP_TRUSTED_HOSTS=
# Per-owner inference rate limits (Phase 4, Wave A): the sustained requests/minute
# and burst ceiling for POST /v1/chat/completions, keyed by the authenticated user
# id (NOT the API key — a user with many keys cannot rotate to bypass). Defaults
# 60 / 20 if unset.
INFERENCE_RATE_LIMIT=60
INFERENCE_RATE_BURST=20
# Per-user concurrency budget (Phase 4, Wave A): max in-flight chat operations
# (sync streams + background jobs share one per-user pool) and how many background
# admissions may queue per owner before rejection (429 busy / 503 busy +
# Retry-After). Defaults 2 / 3 if unset.
BUDGET_MAX_CONCURRENT=2
BUDGET_QUEUE_MAX=3
BUDGET_MODEL_CALL_LIMIT=60
BUDGET_MODEL_CALL_WINDOW_MS=60000
CONTEXT_TOKEN_LIMIT=32768
# Skill injection budget for composeAgentPrompt (chars/4 token heuristic).
AGENT_SKILL_BUDGET_TOKENS=6000
# Custom-agent spec guard rails (request-body size caps in the chat transport).
AGENT_SPEC_MAX_SYSTEM_PROMPT=8000
AGENT_SPEC_MAX_SKILLS=50
AGENT_SPEC_MAX_MCPS=20
AGENT_SPEC_MAX_TOOLS=100
WARMUP_ENABLED=false
WARMUP_MAX_CONCURRENT=2
WARMUP_TIMEOUT_MS=10000
# Outbound model-call timeout (ms). Default 60000.
MODEL_CALL_TIMEOUT_MS=60000
# Per-call timeout (ms) for MCP JSON-RPC. Default 15000.
MCP_CALL_TIMEOUT_MS=15000
# Console log level: error | warn | info | debug. Default info.
LOG_LEVEL=info
# ntfy push-notification server base URL (e.g. https://ntfy.example.com).
# Empty = push notifications disabled (default).
#NOTIFY_BASE_URL=
# development | production (production enables secure cookies)
NODE_ENV=development
# Default model plugin provider override — provider-agnostic. The builtin model
# plugin's endpoint + default model come from these (OpenRouter defaults), so a
# self-hosted operator can point at any OpenAI-compatible provider without
# editing code. Everything else about the builtin is fixed.
#DEFAULT_MODEL_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#DEFAULT_MODEL_PROVIDER_MODEL=openrouter/auto