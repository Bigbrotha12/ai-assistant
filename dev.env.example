# Persistent dev.sh configuration. Copy to dev.env (gitignored) and adjust.
# Values only apply when the corresponding environment variable is unset —
# an explicitly exported env var always wins, e.g.:
#   FLUTTER_DEVICE=pixel ./dev.sh

# Device passed to flutter run -d: 'linux', a device id, or a name substring
# (list them with: flutter devices). Example for USB Android: 33171FDH3000VP
#FLUTTER_DEVICE=linux

# Backend host baked into the app via --dart-define=HOST_FQDN. When unset,
# dev.sh defaults to this machine's Tailscale IPv4 (reachable from the Linux
# desktop over loopback and from tailnet phones over Tailscale), falling back
# to localhost when Tailscale is unavailable.
#HOST_FQDN=

# Flutter SDK binary path.
#FLUTTER=

# Extra args appended to flutter run (alternative to ./dev.sh -- ...).
#FLUTTER_ARGS=

# LLM inference override: route the voice assistant's chat through an external
# OpenAI-compatible Agents API (e.g. a LibreChat agent) instead of the local
# gateway. Forwarded to flutter run as --dart-define. When unset, the app falls
# back to the gateway LLM proxy.
#   LLM_BASE_URL  Base root incl. /v1, e.g. https://<host>/api/agents/v1
#   LLM_MODEL     Model id, e.g. a LibreChat agent id (agent_<id>)
#   LLM_API_KEY   Bearer key (keep it in dev.env, which is gitignored)
#LLM_BASE_URL=
#LLM_MODEL=
#LLM_API_KEY=
